server {
    server_name skinsurance.tech www.skinsurance.tech;
    client_max_body_size 100M;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
    }

    location /static/ {
        alias /var/www/insurance-app/static/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/skinsurance.tech/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/skinsurance.tech/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.skinsurance.tech) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = skinsurance.tech) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name skinsurance.tech www.skinsurance.tech;
    return 404; # managed by Certbot
}
